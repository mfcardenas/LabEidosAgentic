# Copia este fichero a .env y ajusta lo que necesites. Todo es opcional.

# ── Azure OpenAI (modelo cloud, se elige en /admin.html) ───────────────────────────────
# Pon aquí solo marcadores: la clave real va en .env, que no se comparte.
AZURE_OPENAI_ENDPOINT=https://<tu-recurso>.openai.azure.com/
AZURE_OPENAI_API_KEY=<tu-api-key>
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=<nombre-del-deployment>
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# Modelo activo al arrancar si aún no se ha elegido otro en /admin.html: local | azure
LLM_PROFILE=local

# Plataforma nueva (platform/): perfil de modelo de los agentes: fake | local | azure
EIDOS_PROFILE=fake

# Servidor
PORT=3000
HOST=127.0.0.1

# Proveedor del modelo:
#   ollama  → API nativa de Ollama (recomendado: permite fijar el contexto con LLM_NUM_CTX)
#   openai  → cualquier servidor compatible con OpenAI (LM Studio, llama.cpp, vLLM…)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
# Para LM Studio, por ejemplo:
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=
# URL del modelo vista desde Docker (start.ps1 / start.sh). Por defecto, Ollama en el host.
# Para LM Studio: DOCKER_LLM_BASE_URL=http://host.docker.internal:1234/v1
DOCKER_LLM_BASE_URL=http://host.docker.internal:11434

# Modelos de cada agente. gpt-oss:20b va bien con ~16 GB de RAM/VRAM; gpt-oss:120b necesita mucho más.
ROUTER_MODEL=gpt-oss:20b
COMPOSER_MODEL=gpt-oss:20b

# Esfuerzo de razonamiento de gpt-oss (low | medium | high). Vacío = el del modelo.
ROUTER_REASONING=low
COMPOSER_REASONING=medium

# Contexto en tokens (solo Ollama). El prompt del Compositor ronda los 4-5k tokens:
# con el valor por defecto de Ollama se cortaría sin avisar.
LLM_NUM_CTX=16384

# Temperatura. Vacío = la del modelo.
LLM_TEMPERATURE=

# Pide a Ollama/servidor salida JSON estricta. Déjalo en false si tu versión da problemas con gpt-oss.
LLM_JSON_MODE=false

# Tiempo máximo por llamada al modelo (ms). En CPU la primera pantalla puede tardar minutos.
LLM_TIMEOUT_MS=600000

# Guarda cada prompt y respuesta en data/logs/ para depurar
LOG_PROMPTS=false

# Base de datos
DB_FILE=data/eidos.db
# Carga los usuarios de ejemplo de seeds/ si la tabla está vacía
SEED=true
