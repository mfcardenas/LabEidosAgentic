{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eidos-ui/1",
  "title": "ScreenDocument",
  "type": "object",
  "required": [
    "contract",
    "view",
    "root",
    "components"
  ],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "eidos-ui/1"
    },
    "view": {
      "type": "string"
    },
    "root": {
      "$ref": "#/$defs/Id"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {
            "title": "Alert",
            "description": "Aviso destacado.",
            "type": "object",
            "required": [
              "id",
              "component",
              "tone",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/Id"
              },
              "component": {
                "const": "Alert"
              },
              "tone": {
                "enum": [
                  "info",
                  "warn",
                  "danger",
                  "good"
                ]
              },
              "title": {
                "type": "string"
              },
              "text": {
                "$ref": "#/$defs/Value"
              },
              "visible": {
                "$ref": "#/$defs/Condition"
              }
            }
          },
          {
            "title": "BarList",
            "description": "Reparto en barras horizontales.",
            "type": "object",
            "required": [
              "id",
              "component",
              "items"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/Id"
              },
              "component": {
                "const": "BarList"
              },
              "items": {
                "$ref": "#/$defs/Path"
              },
              "visible": {
                "$ref": "#/$defs/Condition"
              }
            }
          },
          {
            "title": "Button",
            "description": "Botón que navega o ejecuta un comando.",
            "type": "object",
            "required": [
              "id",
              "component",
              "label",
              "variant",
              "action"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/Id"
              },
              "component": {
                "const": "Button"
              },
              "label": {
                "type": "string"
              },
              "variant": {
                "enum": [
                  "primary",
                  "secondary",
                  "ghost",
                  "danger"
                ]
              },
              "action": {
                "$ref": "#/$defs/Action"
              },
              "visible": {
                "$ref": "#/$defs/Condition"
              }
            }
          },
          {
            "title": "Card",
            "description": "Tarjeta con título que agrupa contenido relacionado.",
            "type": "object",
            "required": [
              "id",
              "component",
              "children"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/Id"
              },
              "component": {
                "const": "Card"
              },
              "title": {
                "$ref": "#/$defs/Value"
              },
              "children": {
                "$ref": "#/$defs/Ids"
              },
              "visible": {
                "$ref": "#/$defs/Condition"
              }
            }
          },
          {
            "title": "Columns",
            "description": "Fila de elementos que se apila en pantallas estrechas. Para varias Stat o dos Card.",
            "type": "object",
            "required": [
              "id",
              "component",
              "children"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/Id"
              },
              "component": {
                "const": "Columns"
              },
              "children": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Id"
                },
                "minItems": 1,
                "maxItems": 4
              },
              "visible": {
                "$ref": "#/$defs/Condition"
              }
            }
          },
          {
            "title": "Empty",
            "description": "Estado vacío con título, explicación y acciones opcionales.",
            "type": "object",
            "required": [
              "id",
              "component",
              "title",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/Id"
              },
              "component": {
                "const": "Empty"
              },
              "title": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "actions": {
                "$ref": "#/$defs/Ids"
              },
              "visible": {
                "$ref": "#/$defs/Condition"
              }
            }
          },
          {
            "title": "Form",
            "description": "Formulario que ejecuta un comando declarado. Tipos de entrada, valores y validación los pone el runtime a partir de la entidad.",
            "type": "object",
            "required": [
              "id",
              "component",
              "command",
              "fields",
              "submit"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/Id"
              },
              "component": {
                "const": "Form"
              },
              "command": {
                "type": "string"
              },
              "fields": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "field"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "field": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "help": {
                      "type": "string"
                    }
                  }
                }
              },
              "submit": {
                "type": "object",
                "required": [
                  "label"
                ],
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string"
                  }
                }
              },
              "cancel": {
                "type": "object",
                "required": [
                  "label",
                  "action"
                ],
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "action": {
                    "$ref": "#/$defs/Navigate"
                  }
                }
              },
              "visible": {
                "$ref": "#/$defs/Condition"
              }
            }
          },
          {
            "title": "KeyValue",
            "description": "Lista de pares etiqueta-valor para mostrar un registro.",
            "type": "object",
            "required": [
              "id",
              "component",
              "items"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/Id"
              },
              "component": {
                "const": "KeyValue"
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "label",
                    "value"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "value": {
                      "$ref": "#/$defs/Value"
                    },
                    "format": {
                      "$ref": "#/$defs/Format"
                    }
                  }
                }
              },
              "visible": {
                "$ref": "#/$defs/Condition"
              }
            }
          },
          {
            "title": "Page",
            "description": "Raíz de toda pantalla: cabecera con título, subtítulo y acciones, y el contenido.",
            "type": "object",
            "required": [
              "id",
              "component",
              "title",
              "children"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/Id"
              },
              "component": {
                "const": "Page"
              },
              "title": {
                "$ref": "#/$defs/Value"
              },
              "subtitle": {
                "$ref": "#/$defs/Value"
              },
              "actions": {
                "$ref": "#/$defs/Ids"
              },
              "children": {
                "$ref": "#/$defs/Ids"
              },
              "visible": {
                "$ref": "#/$defs/Condition"
              }
            }
          },
          {
            "title": "Stat",
            "description": "Métrica destacada con etiqueta.",
            "type": "object",
            "required": [
              "id",
              "component",
              "label",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/Id"
              },
              "component": {
                "const": "Stat"
              },
              "label": {
                "type": "string"
              },
              "value": {
                "$ref": "#/$defs/Value"
              },
              "hint": {
                "type": "string"
              },
              "tone": {
                "$ref": "#/$defs/Tone"
              },
              "visible": {
                "$ref": "#/$defs/Condition"
              }
            }
          },
          {
            "title": "Table",
            "description": "Tabla de registros. Las columnas son campos del registro; la fila puede abrir otra vista.",
            "type": "object",
            "required": [
              "id",
              "component",
              "rows",
              "columns"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/Id"
              },
              "component": {
                "const": "Table"
              },
              "rows": {
                "$ref": "#/$defs/Path"
              },
              "columns": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "required": [
                    "field",
                    "label"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "field": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "format": {
                      "$ref": "#/$defs/Format"
                    }
                  }
                }
              },
              "rowAction": {
                "$ref": "#/$defs/Navigate"
              },
              "empty": {
                "type": "string"
              },
              "visible": {
                "$ref": "#/$defs/Condition"
              }
            }
          },
          {
            "title": "Text",
            "description": "Párrafo de texto.",
            "type": "object",
            "required": [
              "id",
              "component",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/Id"
              },
              "component": {
                "const": "Text"
              },
              "value": {
                "$ref": "#/$defs/Value"
              },
              "variant": {
                "enum": [
                  "body",
                  "lead",
                  "muted"
                ]
              },
              "visible": {
                "$ref": "#/$defs/Condition"
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Identificador único del componente en la pantalla (kebab-case)."
    },
    "Ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Id"
      }
    },
    "Path": {
      "type": "object",
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(/[A-Za-z0-9_]+)+$",
          "description": "JSON Pointer al modelo de datos de la vista, p. ej. /item/nombre"
        }
      }
    },
    "Template": {
      "type": "object",
      "required": [
        "template"
      ],
      "additionalProperties": false,
      "properties": {
        "template": {
          "type": "string",
          "description": "Texto con rutas interpoladas: \"${/count} resultados\""
        }
      }
    },
    "Value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/Path"
        },
        {
          "$ref": "#/$defs/Template"
        }
      ]
    },
    "Condition": {
      "anyOf": [
        {
          "$ref": "#/$defs/Path"
        },
        {
          "type": "object",
          "required": [
            "not"
          ],
          "additionalProperties": false,
          "properties": {
            "not": {
              "$ref": "#/$defs/Path"
            }
          }
        }
      ]
    },
    "Navigate": {
      "type": "object",
      "required": [
        "function",
        "args"
      ],
      "additionalProperties": false,
      "properties": {
        "function": {
          "const": "navigate"
        },
        "args": {
          "type": "object",
          "required": [
            "view"
          ],
          "additionalProperties": false,
          "properties": {
            "view": {
              "type": "string"
            },
            "params": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/Value"
              }
            }
          }
        }
      }
    },
    "Command": {
      "type": "object",
      "required": [
        "command"
      ],
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string"
        },
        "input": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Value"
          }
        }
      }
    },
    "Action": {
      "anyOf": [
        {
          "$ref": "#/$defs/Navigate"
        },
        {
          "$ref": "#/$defs/Command"
        }
      ]
    },
    "Tone": {
      "enum": [
        "neutral",
        "accent",
        "info",
        "good",
        "warn",
        "bad"
      ]
    },
    "Format": {
      "enum": [
        "text",
        "person",
        "badge",
        "status",
        "date",
        "datetime",
        "email",
        "number"
      ]
    }
  }
}