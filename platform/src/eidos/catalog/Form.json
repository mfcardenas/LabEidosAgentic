{
  "$id": "eidos-catalog/1/Form",
  "title": "Form",
  "description": "Formulario que ejecuta un comando declarado. Tipos de entrada, valores y validación los pone el runtime a partir de la entidad.",
  "x-eidos": { "version": "1.0.0", "container": false, "usage": ["command: el comando de la vista", "fields: todos los campos editables, identidad primero y permisos después"] },
  "type": "object",
  "required": ["id", "component", "command", "fields", "submit"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "#/$defs/Id" },
    "component": { "const": "Form" },
    "command": { "type": "string" },
    "fields": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["field"], "additionalProperties": false,
        "properties": { "field": { "type": "string" }, "label": { "type": "string" }, "help": { "type": "string" } }
      }
    },
    "submit": { "type": "object", "required": ["label"], "additionalProperties": false, "properties": { "label": { "type": "string" } } },
    "cancel": {
      "type": "object", "required": ["label", "action"], "additionalProperties": false,
      "properties": { "label": { "type": "string" }, "action": { "$ref": "#/$defs/Navigate" } }
    },
    "visible": { "$ref": "#/$defs/Condition" }
  }
}
